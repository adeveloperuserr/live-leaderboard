@if (!IsAvailable)
{
    <div class="projection-status projection-unavailable" data-testid="projection-unavailable" role="status">
        <strong>Standings are catching up</strong>
        <span>The latest results will appear here shortly. Please try again in a moment.</span>
    </div>
}
else
{
    <div class="projection-status @(IsLive ? "projection-live" : "projection-completed")" role="status">
        @if (IsLive)
        {
            <span class="status-pill live-pill" data-testid="live-status"><span class="live-dot"></span>LIVE</span>
            <span>Scores update for everyone in real time.</span>
        }
        else
        {
            <span class="status-pill completed-pill" data-testid="completed-status">FINAL</span>
            <span>This competition is complete.</span>
        }
    </div>
}

@code {
    [Parameter]
    public bool IsAvailable { get; set; }

    [Parameter]
    public bool IsLive { get; set; }

    [Parameter]
    public DateTime ProjectedAtUtc { get; set; }

}
