@inherits LayoutComponentBase

<div class="page app-shell">
    <div class="sidebar app-sidebar">
        <NavMenu />
    </div>

    <main class="app-main">
        <div class="top-row app-topbar px-4">
            <span class="topbar-context">Liveboard <span>/</span> Public competition system</span>
            <a href="/" class="topbar-link">Public boards</a>
        </div>

        <article class="content app-content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
